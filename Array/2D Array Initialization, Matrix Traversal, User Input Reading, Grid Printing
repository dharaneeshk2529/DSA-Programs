import java.util.Scanner;

class MatrixOperations {
    public static void main(String[] args) {
        int[][] sample = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
        
        int row = 3;
        int col = 3;
        int[][] a = new int[row][col];
        Scanner s = new Scanner(System.in);

        for (int i = 0; i < row; i++) {
            for (int j = 0; j < col; j++) {
                a[i][j] = s.nextInt();
            }
        }

        for (int i = 0; i < row; i++) {
            for (int j = 0; j < col; j++) {
                System.out.print(a[i][j] + " ");
            }
            System.out.println();
        }
    }
}
